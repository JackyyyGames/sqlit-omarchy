# Maintainer: JackyyyGames
pkgname=sqlit-omarchy
pkgver=1.0.1
pkgrel=1
pkgdesc="SQL terminal UI with automatic Omarchy theme synchronization"
arch=('any')
url="https://github.com/JackyyyGames/sqlit-omarchy"
license=('MIT')
provides=('sqlit')
conflicts=('sqlit')
replaces=('sqlit')
depends=(
    'python'
    'python-textual'
    'python-textual-fastdatatable'
    'python-pyperclip'
    'python-keyring'
    'python-docker'
    'python-sqlparse'
)
optdepends=(
    'python-psycopg2: PostgreSQL, CockroachDB and Supabase support'
    'python-pyodbc: SQL Server support'
    'python-pymysql: MySQL and MariaDB support'
    'python-oracledb: Oracle support'
    'python-duckdb: DuckDB support'
    'python-clickhouse-connect: ClickHouse support'
    'python-requests: Cloudflare D1 support'
    'python-snowflake-connector-python: Snowflake support'
    'python-paramiko: SSH tunnel support'
    'python-sshtunnel: SSH tunnel support'
)
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-hatch-vcs')
source=("https://github.com/JackyyyGames/sqlit-omarchy/archive/refs/tags/omarchy-v${pkgver}.tar.gz")
sha256sums=('acd15273714b32b57172369d1ea0f0bc5661fbb5d01c23f114b0f0b132c3021b')

build() {
    cd "${pkgname}-omarchy-v${pkgver}"
    SETUPTOOLS_SCM_PRETEND_VERSION="${pkgver}" python -m build --wheel --no-isolation
}

package() {
    cd "${pkgname}-omarchy-v${pkgver}"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
